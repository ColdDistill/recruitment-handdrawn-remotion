{
  "name": "selerb-recruitment-handdrawn-promo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "招聘工作台宣传文案的手绘动画版本",
  "scripts": {
    "start": "remotion studio src/index.ts",
    "build": "node scripts/build-preview.mjs",
    "check": "tsc --noEmit && node --experimental-strip-types --test src/timeline.test.ts",
    "render": "remotion render src/index.ts RecruitmentHanddrawn delivery/招聘工作台-手绘宣传片.mp4 --codec=h264 --crf=17 --scale=1.5",
    "still": "remotion still src/index.ts RecruitmentHanddrawn delivery/封面.png --frame=890 --scale=1.5",
    "verify": "node scripts/verify-delivery.mjs",
    "music": "node scripts/music.mjs",
    "preview": "node scripts/serve-preview.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.529",
    "@remotion/player": "4.0.529",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
